[
  {
    "name": "finishes",
    "script": [
      {"type": "tool_use", "id": "toolu_01", "name": "list_files", "input": {"directory": "chapters"},
       "text": "Let me look at the repository first."},
      {"type": "text", "text": "It is a conversation loop over the Messages API."}
    ],
    "expect_stdout": [
      "-> list_files({\"directory\": \"chapters\"})",
      "It is a conversation loop over the Messages API.",
      "[turn 2: 10 in, 9 out, $",
      "[done: 2 turns, $"
    ],
    "expect_calls": 2,
    "expect_tool_results": 1,
    "expect_tool_errors": 0
  },
  {
    "name": "cycle",
    "script": [
      {"type": "tool_use", "id": "toolu_01", "name": "read_file", "input": {"path": "chapters/01_the_loop.py"},
       "text": "I will read chapter 1."},
      {"type": "tool_use", "id": "toolu_02", "name": "read_file", "input": {"path": "chapters/01_the_loop.py"},
       "text": "Let me read it again to be sure."},
      {"type": "tool_use", "id": "toolu_03", "name": "read_file", "input": {"path": "chapters/01_the_loop.py"},
       "text": "I need to check the file once more."}
    ],
    "expect_stdout": [
      "I will read chapter 1.",
      "-> read_file({\"path\": \"chapters/01_the_loop.py\"})",
      "Let me read it again to be sure.",
      "   repeat: you already called read_file({\"path\": \"chapters/01_the_loop.py\"}) and the result has not changed.",
      "I need to check the file once more.",
      "[stopped: cycle, read_file({\"path\": \"chapters/01_the_loop.py\"}) requested 3 times]"
    ],
    "expect_calls": 3,
    "expect_tool_errors": 1
  },
  {
    "name": "usd_cap",
    "env": {"MAX_USD": "0.01"},
    "script": [
      {"type": "tool_use", "id": "toolu_01", "name": "list_files", "input": {"directory": "chapters"},
       "text": "Let me look at the repository first.",
       "usage": {"input_tokens": 1000, "output_tokens": 300}}
    ],
    "expect_stdout": [
      "[turn 1: 1000 in, 300 out, $0.0125]",
      "[stopped: $0.0125 spent, cap is $0.01]"
    ],
    "expect_calls": 1
  },
  {
    "name": "turn_cap",
    "env": {"MAX_TURNS": "2"},
    "script": [
      {"type": "tool_use", "id": "toolu_01", "name": "list_files", "input": {"directory": "chapters"}},
      {"type": "tool_use", "id": "toolu_02", "name": "read_file", "input": {"path": "chapters/01_the_loop.py"}}
    ],
    "expect_stdout": [
      "-> list_files({\"directory\": \"chapters\"})",
      "-> read_file({\"path\": \"chapters/01_the_loop.py\"})",
      "[stopped: turn cap of 2 reached, $"
    ],
    "expect_calls": 2,
    "expect_tool_errors": 0
  }
]
