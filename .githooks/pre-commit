#!/bin/sh
# Quality gate. No red commit reaches main.
[ "$SKIP_GATE" = "1" ] && { echo "pre-commit: GATE BYPASSED"; exit 0; }
fail() { echo ""; echo "pre-commit: BLOCKED — $1"; echo "  Fix it or revert. Do not bypass to 'make progress'."; exit 1; }

# Prefer the project venv, so the gate uses pinned tooling rather than whatever
# happens to be on PATH.
if   [ -x .venv/Scripts/python.exe ]; then PY=.venv/Scripts/python.exe
elif [ -x .venv/bin/python ];        then PY=.venv/bin/python
else PY=python
fi

[ -f pyproject.toml ] || { echo "pre-commit: no pyproject.toml yet, gate idle"; exit 0; }

$PY -c "import ruff" >/dev/null 2>&1 || $PY -m ruff --version >/dev/null 2>&1 \
  || fail "ruff not installed — run: make install"

echo "pre-commit: ruff check";        $PY -m ruff check .        || fail "lint errors"
echo "pre-commit: ruff format";       $PY -m ruff format --check . || fail "formatting drift — run 'ruff format .'"
echo "pre-commit: mypy --strict";     $PY -m mypy               || fail "type errors"
echo "pre-commit: pytest";            $PY -m pytest -q          || fail "tests failing"
echo "pre-commit: gate passed"
